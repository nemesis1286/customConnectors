{
    "name": "AnthropicClaudeActivities",
    "apiVersion": "2022-12-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
        "connectorDefinitionName": "AnthropicClaudeActivitiesCCFDefinition",
        "dataType": "[variables('_logAnalyticsTableId1')]",
        "isActive": true,
        "auth": {
            "type": "APIKey",
            "apiKey": "{{apiKey}}",
            "apiKeyName": "x-api-key"
        },
        "request": {
            "apiEndpoint": "https://api.anthropic.com/v1/compliance/activities",
            "httpMethod": "GET",
            "queryWindowInMin": 5,
            "rateLimitQPS": 10,
            "retryCount": 3,
            "timeoutInSeconds": 60,
            "headers": {
                "Accept": "application/json",
                "User-Agent": "SentinelCCF-AnthropicClaudeActivities/1.1"
            },
            "queryParameters": {
                "limit": 1000,
                "order": "asc",
                "created_at.gte": "{{startDate}}"
            }
        },
        "paging": {
            "pagingType": "PersistentToken",
            "nextPageParaName": "after_id",
            "nextPageTokenJsonPath": "$.last_id",
            "hasNextFlagJsonPath": "$.has_more"
        },
        "response": {
            "eventsJsonPaths": [
                "$.data[*]"
            ],
            "format": "json"
        },
        "dcrConfig": {
            "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
            "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
            "streamName": "Custom-ClaudeActivity_CL"
        }
    }
}
