              "kind": null,
              "properties": {
                "dataCollectionEndpointId": "[concat('/subscriptions/',parameters('subscription'),'/resourceGroups/',parameters('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]",
                "streamDeclarations": {
                  "Custom-ClaudeActivity_CL": {
                    "columns": [
                      {
                        "name": "actor",
                        "type": "dynamic"
                      },
                      {
                        "name": "claude_chat_id",
                        "type": "string"
                      },
                      {
                        "name": "claude_project_id",
                        "type": "dynamic"
                      },
                      {
                        "name": "created_at",
                        "type": "string"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "organization_id",
                        "type": "string"
                      },
                      {
                        "name": "type",
                        "type": "string"
                      },
                      {
                        "name": "organization_uuid",
                        "type": "string"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "clv2ws1"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-ClaudeActivity_CL"
                    ],
                    "destinations": [
                      "clv2ws1"
                    ],
                    "outputStream": "Custom-ClaudeActivity_CL",
                    "transformKql": "source | project TimeGenerated = now(), ActorEmailAddress = tostring(actor.email_address), ActorIpAddress = tostring(actor.ip_address), ActorType = tostring(actor.type), ActorUserAgent = tostring(actor.user_agent), ActorUserId = tostring(actor.user_id), ClaudeChatId = ['claude_chat_id'], ClaudeProjectId = ['claude_project_id'], CreatedAt = ['created_at'], Id = ['id'], OrganizationId = ['organization_id'], ActivityType = ['type'], OrganizationUuid = ['organization_uuid']"
                  }
                ]
              }
            },
            {
              "name": "[variables('_logAnalyticsTableId1')]",
              "tags": {
                "StreamName": "Custom-ClaudeActivity_CL",
                "DataSource": "(wizard-made) Anthropic Claude Activities Connector",
                "Category": "Security"
              },
              "apiVersion": "2021-03-01-privatepreview",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "retentionInDays": 90,
                "schema": {
                  "name": "[variables('_logAnalyticsTableId1')]",
                  "description": "Anthropic Claude Activities data (prototype schema)",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime",
                      "description": "Time of log ingestion"
                    },
                    {
                      "name": "ActorEmailAddress",
                      "type": "string"
                    },
                    {
                      "name": "ActorIpAddress",
                      "type": "string"
                    },
                    {
                      "name": "ActorType",
                      "type": "string"
                    },
                    {
                      "name": "ActorUserAgent",
                      "type": "string"
                    },
                    {
                      "name": "ActorUserId",
                      "type": "string"
                    },
                    {
                      "name": "ClaudeChatId",
                      "type": "string"
                    },
                    {
                      "name": "ClaudeProjectId",
                      "type": "dynamic"
                    },
                    {
                      "name": "CreatedAt",
                      "type": "string"
                    },
                    {
                      "name": "Id",
                      "type": "string"
                    },
                    {
                      "name": "OrganizationId",
                      "type": "string"
                    },
                    {
                      "name": "ActivityType",
                      "type": "string"
                    },
                    {
                      "name": "OrganizationUuid",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "contentProductId": "[concat(substring(variables('_solutionId'), 0, 50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentIdConnectorDefinition'),'-', variables('dataConnectorVersionConnectorDefinition'))))]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "version": "[variables('_solutionVersion')]"
