{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "minLength": 1,
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for all deployed resources (Data Collection Endpoint, Data Collection Rule, custom table, and Sentinel content). Defaults to the resource group's location, which must match the Log Analytics workspace region."
      }
    },
    "workspace": {
      "defaultValue": "",
      "type": "string",
      "metadata": {
        "description": "Workspace name for Log Analytics where Microsoft Sentinel is setup"
      }
    }
  },
  "variables": {
    "subscription": "[subscription().subscriptionId]",
    "resourceGroupName": "[resourceGroup().name]",
    "workspaceResourceId": "[resourceId('microsoft.OperationalInsights/Workspaces', parameters('workspace'))]",
    "_solutionName": "Anthropic Claude Activities",
    "_solutionVersion": "3.0.2",
    "_solutionAuthor": "Lamar Arnau",
    "_packageIcon": "icon",
    "_solutionId": "azuresentinel.azure-sentinel-solution-azuresentinel.azure-sentinel-Anthropic-Claude-Activities-dev-preview",
    "dataConnectorVersionConnectorDefinition": "1.0.20260812000001",
    "dataConnectorVersionConnections": "1.0.20260812000001",
    "_solutionTier": "Community",
    "_dataConnectorContentIdConnections": "Anthropic-Claude-ActivitiesConnections",
    "dataConnectorTemplateNameConnections": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnections')))]",
    "_dataConnectorContentIdConnectorDefinition": "Anthropic-Claude-Activities-wizard-made-CCF",
    "dataConnectorTemplateNameConnectorDefinition": "[concat(parameters('workspace'),'-dc-',uniquestring(variables('_dataConnectorContentIdConnectorDefinition')))]",
    "_logAnalyticsTableId1": "ClaudeActivity_CL",
    "_parserName1": "ClaudeActivity",
    "_parserContentId1": "ClaudeActivity-Parser",
    "parserVersion1": "1.0.0",
    "parserTemplateSpecName1": "[concat(parameters('workspace'),'-pr-',uniquestring(variables('_parserContentId1')))]"
  },
  "resources": [
    {
      "comments": "Data Collection Endpoint named after the workspace. The DCR references a DCE by this exact name; creating it here lets the connector stand up in a fresh tenant that has no DCE yet. Idempotent on environments that already have one.",
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2022-06-01",
      "name": "[parameters('workspace')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "comments": "Custom table created at deploy time so it exists and becomes bindable before Connect instantiates the DCR. This is what prevents the InvalidOutputTable race on a fresh Connect. Schema must stay identical to the copy inside the connector-definition mainTemplate.",
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('workspace'),'/',variables('_logAnalyticsTableId1'))]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 90,
        "schema": {
          "name": "[variables('_logAnalyticsTableId1')]",
          "description": "Anthropic Claude Compliance API Activity Feed events",
          "columns": [
            { "name": "TimeGenerated", "type": "datetime", "description": "Event time of the activity (created_at)" },
            { "name": "ActivityType", "type": "string", "description": "Activity type, for example claude_file_uploaded" },
            { "name": "Id", "type": "string", "description": "Unique activity identifier; use for de-duplication" },
            { "name": "CreatedAt", "type": "datetime", "description": "Time the activity occurred, as reported by Claude" },
            { "name": "Actor", "type": "dynamic", "description": "Full actor object; retains fields for all actor types including SCIM, federated identity, and service accounts. Flattened into Actor* fields at query time by the ClaudeActivity parser." },
            { "name": "ClaudeChatId", "type": "string" },
            { "name": "ClaudeProjectId", "type": "string" },
            { "name": "Filename", "type": "string", "description": "File name, present on claude_file_* activities" },
            { "name": "OrganizationId", "type": "string" },
            { "name": "OrganizationUuid", "type": "string" }
          ]
        }
      }
    },
    {
      "comments": "Live workspace function (parser) that flattens the Actor dynamic object into the nine Actor* fields at query time. Created as a top-level resource so it deploys on the direct-deploy path; a stored copy also ships as Parser solution content (below) for Content Hub. Query it as 'ClaudeActivity' instead of the raw ClaudeActivity_CL table.",
      "type": "Microsoft.OperationalInsights/workspaces/savedSearches",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('workspace'), '/', variables('_parserName1'))]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspace'), variables('_logAnalyticsTableId1'))]"
      ],
      "properties": {
        "etag": "*",
        "displayName": "ClaudeActivity",
        "category": "Microsoft Sentinel Parser",
        "functionAlias": "ClaudeActivity",
        "functionParameters": "",
        "version": 2,
        "query": "ClaudeActivity_CL\n| extend\n    ActorType = tostring(Actor.type),\n    ActorEmailAddress = tostring(Actor.email_address),\n    ActorUserId = tostring(Actor.user_id),\n    ActorIpAddress = tostring(Actor.ip_address),\n    ActorUserAgent = tostring(Actor.user_agent),\n    ActorApiKeyId = tostring(Actor.api_key_id),\n    ActorAdminApiKeyId = tostring(Actor.admin_api_key_id),\n    ActorServiceAccountId = tostring(Actor.service_account_id),\n    ActorUnauthenticatedEmailAddress = tostring(Actor.unauthenticated_email_address)\n| project-reorder TimeGenerated, ActivityType, ActorType, ActorUserId, ActorEmailAddress, ActorIpAddress, ActorUserAgent"
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/contentTemplates",
      "apiVersion": "2023-04-01-preview",
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/', variables('dataConnectorTemplateNameConnectorDefinition'), variables('dataConnectorVersionConnectorDefinition'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/contentPackages', variables('_solutionId'))]"
      ],
      "properties": {
        "contentId": "[variables('_dataConnectorContentIdConnectorDefinition')]",
        "displayName": "[concat(variables('_solutionName'), variables('dataConnectorTemplateNameConnectorDefinition'))]",
        "contentKind": "DataConnector",
        "mainTemplate": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "[variables('dataConnectorVersionConnectorDefinition')]",
          "parameters": {},
          "variables": {},
          "resources": [
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',concat('DataConnector-', variables('_dataConnectorContentIdConnectorDefinition')))]",
              "apiVersion": "2022-01-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/metadata",
              "properties": {
                "parentId": "[extensionResourceId(resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspace')), 'Microsoft.SecurityInsights/dataConnectorDefinitions', variables('_dataConnectorContentIdConnectorDefinition'))]",
                "contentId": "[variables('_dataConnectorContentIdConnectorDefinition')]",
                "kind": "DataConnector",
                "version": "[variables('dataConnectorVersionConnectorDefinition')]",
                "source": {
                  "sourceId": "[variables('_solutionId')]",
                  "name": "[variables('_solutionName')]",
                  "kind": "Solution"
                },
                "author": {
                  "name": "[variables('_solutionAuthor')]"
                },
                "support": {
                  "name": "[variables('_solutionAuthor')]",
                  "tier": "[variables('_solutionTier')]"
                },
                "dependencies": {
                  "criteria": [
                    {
                      "version": "[variables('dataConnectorVersionConnections')]",
                      "contentId": "[variables('_dataConnectorContentIdConnections')]",
                      "kind": "ResourcesDataConnector"
                    }
                  ]
                }
              }
            },
            {
              "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition'))]",
              "apiVersion": "2022-09-01-preview",
              "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
              "location": "[parameters('location')]",
              "kind": "Customizable",
              "properties": {
                "connectorUiConfig": {
                  "id": "Anthropic-Claude-Activities-wizard-made-CCF",
                  "title": "Anthropic Claude Activities",
                  "publisher": "Lamar Arnau",
                  "descriptionMarkdown": "The Claude Activity Feed records authentication, chat, file, project, administrative, and platform actions that occur in your organization. This connector polls the Claude Compliance API Activity Feed endpoint and ingests events into the **ClaudeActivity_CL** table.\n\n**Operational notes:**\n\n- Delivery is at-least-once, so duplicate events are possible. De-duplicate on `Id` at query time (see sample queries).\n- Polling begins at connect time; no historical backfill is performed. Anthropic retains activity data for 6 years and it can be backfilled separately via the Logs Ingestion API if needed.\n- Activities become queryable within roughly one minute of occurring. Because each poll window ends at poll time, an event indexed late may occasionally fall outside its window.",
                  "graphQueriesTableName": "ClaudeActivity_CL",
                  "dataTypes": [
                    {
                      "name": "ClaudeActivity_CL",
                      "lastDataReceivedQuery": "ClaudeActivity_CL\n| where TimeGenerated > ago(12h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "availability": {
                    "isPreview": true,
                    "status": 1
                  },
                  "graphQueries": [
                    {
                      "metricName": "Total data received",
                      "legend": "Anthropic Claude Activities Data",
                      "baseQuery": "{{graphQueriesTableName}}"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "Most recent Claude activities",
                      "query": "{{graphQueriesTableName}}\n| sort by TimeGenerated desc\n| take 50"
                    },
                    {
                      "description": "Activity volume by type (last 7 days)",
                      "query": "{{graphQueriesTableName}}\n| where TimeGenerated > ago(7d)\n| summarize count() by ActivityType\n| sort by count_ desc"
                    },
                    {
                      "description": "File uploads to Claude",
                      "query": "ClaudeActivity\n| where ActivityType == \"claude_file_uploaded\"\n| project TimeGenerated, ActorEmailAddress, Filename, ActorIpAddress"
                    },
                    {
                      "description": "Compliance API access auditing",
                      "query": "ClaudeActivity\n| where ActivityType == \"compliance_api_accessed\"\n| project TimeGenerated, ActorType, Actor"
                    },
                    {
                      "description": "De-duplicated events (delivery is at-least-once)",
                      "query": "{{graphQueriesTableName}}\n| summarize arg_min(TimeGenerated, *) by Id"
                    }
                  ],
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "write": true,
                          "read": true,
                          "delete": true,
                          "action": false
                        }
                      }
                    ],
                    "customs": [
                      {
                        "name": "Claude Compliance API",
                        "description": "Claude Enterprise with the Compliance API enabled, and a Compliance Access Key (sk-ant-api01-...) or Admin API key (sk-ant-admin01-...) carrying the `read:compliance_activities` scope."
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "Obtain Claude Compliance API Key",
                      "description": "Claude Enterprise is required to enable the Compliance API and obtain a Compliance API key.\n\nThe key must carry the `read:compliance_activities` scope. Either a Compliance Access Key (`sk-ant-api01-...`) or an Admin API key (`sk-ant-admin01-...`) with that scope will work.\n\nFor detailed steps on how to enable the Compliance API, generate the key, and the permissions required, see the Claude documentation here: https://platform.claude.com/docs/en/manage-claude/compliance-api-access\n",
                      "instructions": [
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Compliance API Key",
                            "placeholder": "sk-ant-api01-...",
                            "type": "password",
                            "name": "apiKey",
                            "validations": {
                              "required": true
                            }
                          }
                        }
                      ]
                    },
                    {
                      "title": "Connect",
                      "description": "Enable the data connector: Anthropic Claude Activities",
                      "instructions": [
                        {
                          "type": "ConnectionToggleButton",
                          "parameters": {
                            "connectLabel": "Connect",
                            "disconnectLabel": "Disconnect",
                            "name": "toggle"
                          }
                        }
                      ]
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "HasDataConnectors"
                    }
                  ]
                }
              }
            },
            {
              "name": "DCR-AnthropicClaudeActivities",
              "apiVersion": "2022-06-01",
              "type": "Microsoft.Insights/dataCollectionRules",
              "location": "[parameters('location')]",
              "kind": null,
              "properties": {
                "dataCollectionEndpointId": "[concat('/subscriptions/',variables('subscription'),'/resourceGroups/',variables('resourceGroupName'),'/providers/Microsoft.Insights/dataCollectionEndpoints/',parameters('workspace'))]",
                "streamDeclarations": {
                  "Custom-ClaudeActivity_CL": {
                    "columns": [
                      {
                        "name": "actor",
                        "type": "dynamic"
                      },
                      {
                        "name": "claude_chat_id",
                        "type": "string"
                      },
                      {
                        "name": "claude_project_id",
                        "type": "string"
                      },
                      {
                        "name": "created_at",
                        "type": "datetime"
                      },
                      {
                        "name": "filename",
                        "type": "string"
                      },
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "organization_id",
                        "type": "string"
                      },
                      {
                        "name": "type",
                        "type": "string"
                      },
                      {
                        "name": "organization_uuid",
                        "type": "string"
                      }
                    ]
                  }
                },
                "destinations": {
                  "logAnalytics": [
                    {
                      "workspaceResourceId": "[variables('workspaceResourceId')]",
                      "name": "clv2ws1"
                    }
                  ]
                },
                "dataFlows": [
                  {
                    "streams": [
                      "Custom-ClaudeActivity_CL"
                    ],
                    "destinations": [
                      "clv2ws1"
                    ],
                    "outputStream": "Custom-ClaudeActivity_CL",
                    "transformKql": "source\n| project TimeGenerated = iff(isnull(['created_at']), now(), todatetime(['created_at'])),\n    ActivityType = ['type'],\n    Id = ['id'],\n    CreatedAt = ['created_at'],\n    Actor = actor,\n    ClaudeChatId = ['claude_chat_id'],\n    ClaudeProjectId = ['claude_project_id'],\n    Filename = ['filename'],\n    OrganizationId = ['organization_id'],\n    OrganizationUuid = ['organization_uuid']"
                  }
                ]
              }
            },
            {
              "name": "[variables('_logAnalyticsTableId1')]",
              "tags": {
                "StreamName": "Custom-ClaudeActivity_CL",
                "DataSource": "Anthropic Claude Activities Connector",
                "Category": "Security"
              },
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('location')]",
              "kind": null,
              "properties": {
                "retentionInDays": 90,
                "schema": {
                  "name": "[variables('_logAnalyticsTableId1')]",
                  "description": "Anthropic Claude Compliance API Activity Feed events",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime",
                      "description": "Event time of the activity (created_at)",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "ActivityType",
                      "type": "string",
                      "description": "Activity type, for example claude_file_uploaded",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "Id",
                      "type": "string",
                      "description": "Unique activity identifier; use for de-duplication",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "CreatedAt",
                      "type": "datetime",
                      "description": "Time the activity occurred, as reported by Claude",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "Actor",
                      "type": "dynamic",
                      "description": "Full actor object; retains fields for all actor types including SCIM, federated identity, and service accounts",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "ClaudeChatId",
                      "type": "string",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "ClaudeProjectId",
                      "type": "string",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "Filename",
                      "type": "string",
                      "description": "File name, present on claude_file_* activities",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "OrganizationId",
                      "type": "string",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    },
                    {
                      "name": "OrganizationUuid",
                      "type": "string",
                      "isDefaultDisplay": false,
                      "isHidden": false
                    }
                  ]
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "contentProductId": "[concat(substring(variables('_solutionId'), 0, 50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentIdConnectorDefinition'),'-', variables('dataConnectorVersionConnectorDefinition'))))]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "version": "[variables('_solutionVersion')]"
      }
    },
    {
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition'))]",
      "apiVersion": "2022-09-01-preview",
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
      "location": "[parameters('location')]",
      "kind": "Customizable",
      "properties": {
