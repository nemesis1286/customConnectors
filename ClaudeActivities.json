                          "type": "Textbox",
                          "parameters": {
                            "label": "apiKey",
                            "placeholder": "",
                            "type": "password",
                            "name": "apiKey",
                            "validations": {
                              "required": true
                            }
                          }
                        }
                      ]
                    },
                    {
                      "title": "Connect",
                      "description": "Enable the data connector: Anthropic Claude Activities (made with connector-wizard)",
                      "instructions": [
                        {
                          "type": "ConnectionToggleButton",
                          "parameters": {
                            "connectLabel": "Connect",
                            "disconnectLabel": "Disconnect",
                            "name": "toggle"
                          }
                        }
                      ]
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "HasDataConnectors",
                      "value": []
                    }
                  ]
                }
              }
            },
            {
              "name": "DCR-AnthropicClaudeActivities",
              "apiVersion": "2021-09-01-preview",
