              "location": "[parameters('workspace-location')]",
              "kind": "Customizable",
              "properties": {
                "connectorUiConfig": {
                  "id": "Anthropic-Claude-Activities-wizard-made-CCF",
                  "title": "Anthropic Claude Activities (made with connector-wizard)",
                  "publisher": "Lamar Arnau",
                  "descriptionMarkdown": "The Activity Feed records authentication, chat, file, project, administrative, and platform action that occurs in your organization.",
                  "graphQueriesTableName": "Custom-ClaudeActivity_CL",
                  "dataTypes": [
                    {
                      "name": "ClaudeActivity_CL",
                      "lastDataReceivedQuery": "ClaudeActivity_CL\n| where TimeGenerated > ago(12h)\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "availability": {
                    "isPreview": true,
                    "status": 1
                  },
                  "graphQueries": [
                    {
                      "metricName": "Total data received",
                      "legend": "Anthropic Claude Activities Data",
                      "baseQuery": "{{graphQueriesTableName}}"
                    }
                  ],
                  "sampleQueries": [],
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and Write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "write": true,
                          "read": true,
                          "delete": true,
                          "action": false
                        }
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "Obtain Claude Compliance API Key",
                      "description": "Claude Enterprise is required to enable the Compliance API and obtain the Compliance API key.\n\nFor detailed steps on how to enable the Compliance API, generate the key, and permissions required, please see the Claude documentation here: https://platform.claude.com/docs/en/manage-claude/compliance-api-access\n",
                      "instructions": [
